<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">
        <!-- White flash when the dragon crashes. -->
        <ui:VisualElement name="flash" class="flash" picking-mode="Ignore" />

        <!-- Always visible while flying. -->
        <ui:VisualElement name="top-bar" class="top-bar" picking-mode="Ignore">
            <ui:VisualElement class="top-bar__side" picking-mode="Ignore">
                <ui:Label name="best-chip" text="BEST 0" class="chip" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="score" text="0" class="score" picking-mode="Ignore" />
            <ui:VisualElement class="top-bar__side top-bar__side--right" picking-mode="Ignore">
                <ui:Button name="pause-button" text="II" class="round-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Fireball: tap the button on touch screens; its fill shows the recharge. -->
        <ui:Button name="fire-button" class="fire-button">
            <ui:VisualElement name="fire-charge" class="fire-button__charge" picking-mode="Ignore" />
            <ui:Label text="FIRE" class="fire-button__label" picking-mode="Ignore" />
        </ui:Button>

        <ui:VisualElement name="title" class="screen screen--title">
            <ui:VisualElement class="title__panel">
                <ui:Label text="Flappy&#10;Dragon" class="title title--stacked" />
                <ui:Label text="Fly through the rock gates,&#10;grab the coins, burn the bats." class="tagline" />
                <ui:Button name="play-button" text="Play" class="button button--primary button--wide" />
                <ui:VisualElement class="title__best row">
                    <ui:VisualElement name="title-medal" class="medal medal--small" />
                    <ui:Label name="title-best" text="Best 0" class="tagline tagline--small" />
                </ui:VisualElement>
                <ui:VisualElement class="controls">
                    <ui:Label text="Flap: Space, click, tap or (A)" class="controls__item" />
                    <ui:Label text="Fireball: F, right click or (X)" class="controls__item" />
                    <ui:Label text="Pause: Esc, P or Start" class="controls__item" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Waiting for the first flap. -->
        <ui:VisualElement name="ready" class="screen screen--hint" picking-mode="Ignore">
            <ui:Label text="Get ready!" class="title title--small" picking-mode="Ignore" />
            <ui:Label text="Tap, click or press Space to flap" class="hint" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="pause" class="screen screen--dim">
            <ui:VisualElement class="card">
                <ui:Label text="Paused" class="title title--small" />
                <ui:Button name="resume-button" text="Resume" class="button button--primary" />
                <ui:Button name="restart-button" text="Restart" class="button" />
                <ui:Button name="pause-title-button" text="Title screen" class="button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="game-over" class="screen screen--dim">
            <ui:VisualElement class="card">
                <ui:Label text="Game over" class="title title--small" />
                <ui:VisualElement class="results">
                    <ui:VisualElement class="results__column">
                        <ui:Label text="Medal" class="results__label" />
                        <ui:VisualElement name="medal" class="medal">
                            <ui:VisualElement class="medal__shine" />
                        </ui:VisualElement>
                        <ui:Label name="medal-name" text="None yet" class="results__caption" />
                    </ui:VisualElement>
                    <ui:VisualElement class="results__column">
                        <ui:Label text="Score" class="results__label" />
                        <ui:Label name="final-score" text="0" class="results__value" />
                        <ui:VisualElement class="row">
                            <ui:Label text="Best" class="results__label" />
                            <ui:Label name="new-best" text="NEW" class="badge" />
                        </ui:VisualElement>
                        <ui:Label name="best-score" text="0" class="results__value results__value--small" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="next-medal" text="" class="results__caption results__caption--next" />
                <ui:Button name="retry-button" text="Fly again" class="button button--primary" />
                <ui:Button name="over-title-button" text="Title screen" class="button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
