/*
 * Bright storybook HUD: cream cards with a warm brown outline, chunky outlined numbers.
 * Designed at 1280x720 reference pixels; the panel settings scale it to the screen.
 */

:root {
    --ink: #3b2414;
    --cream: #fff4dc;
    --cream-dark: #f1dcb1;
    --accent: #f27a2e;
    --accent-dark: #b9501a;
    --muted: #8a6a4c;
    --gold: #f5c542;

    color: var(--ink);
    font-size: 22px;
    -unity-font-style: bold;
}

.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* ---- Top bar ---- */

.top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    padding: 18px 24px 0 24px;
}

.top-bar__side {
    width: 160px;
    flex-direction: row;
}

.top-bar__side--right {
    justify-content: flex-end;
}

.score {
    font-size: 84px;
    transition-property: scale;
    transition-duration: 0.12s;
    color: #ffffff;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: var(--ink);
    -unity-text-align: middle-center;
    text-shadow: 0 5px 0 rgba(59, 36, 20, 0.55);
}

.score--pop {
    scale: 1.3 1.3;
}

.chip {
    padding: 4px 12px;
    border-radius: 14px;
    background-color: rgba(59, 36, 20, 0.55);
    color: #ffffff;
    font-size: 20px;
}

.round-button {
    width: 64px;
    height: 64px;
    border-radius: 32px;
    border-width: 4px;
    border-color: var(--ink);
    background-color: var(--cream);
    color: var(--ink);
    font-size: 26px;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.round-button:hover {
    background-color: #ffffff;
}

.round-button:active {
    background-color: var(--cream-dark);
}

/* ---- Screens ---- */

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.screen--dim {
    background-color: rgba(30, 18, 10, 0.45);
}

.screen--title {
    align-items: flex-end;
    padding-right: 70px;
}

.title__panel {
    width: 600px;
    align-items: center;
}

.title--stacked {
    font-size: 112px;
    -unity-paragraph-spacing: 0;
    margin-bottom: 8px;
}

.tagline {
    font-size: 26px;
    color: #ffffff;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: var(--ink);
    -unity-text-align: middle-center;
    margin-bottom: 22px;
}

.tagline--small {
    font-size: 24px;
    margin: 0 0 0 10px;
}

.title__best {
    margin-top: 18px;
}

.controls {
    margin-top: 22px;
    padding: 8px 14px;
    border-radius: 14px;
    background-color: rgba(59, 36, 20, 0.5);
}

.controls__item {
    color: var(--cream);
    font-size: 19px;
    margin: 2px 6px;
    -unity-text-align: middle-center;
}

.screen--hint {
    justify-content: flex-end;
    padding-bottom: 150px;
}

.hidden {
    display: none;
}

.card {
    min-width: 420px;
    padding: 26px 40px 30px 40px;
    border-radius: 26px;
    border-width: 5px;
    border-color: var(--ink);
    background-color: var(--cream);
    align-items: stretch;
}

.title {
    font-size: 96px;
    color: var(--gold);
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: var(--ink);
    -unity-text-align: middle-center;
    text-shadow: 0 6px 0 rgba(59, 36, 20, 0.6);
}

.title--small {
    font-size: 56px;
    margin-bottom: 14px;
}

.hint {
    font-size: 28px;
    color: #ffffff;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: var(--ink);
    -unity-text-align: middle-center;
}

.row {
    flex-direction: row;
    align-items: center;
}

/* ---- Buttons ---- */

.button {
    height: 64px;
    margin: 8px 0 0 0;
    border-radius: 18px;
    border-width: 4px;
    border-color: var(--ink);
    background-color: var(--cream-dark);
    color: var(--ink);
    font-size: 28px;
    -unity-text-align: middle-center;
}

.button:hover,
.button:focus {
    background-color: #ffffff;
}

/* Keyboard and gamepad focus: a thick warm outline instead of the default blue. */
.hud .button:focus,
.hud .round-button:focus {
    border-color: var(--accent-dark);
}

.button--wide {
    width: 320px;
    height: 76px;
    font-size: 36px;
}

.button--primary {
    background-color: var(--accent);
    color: #ffffff;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--accent-dark);
}

.button--primary:hover,
.button--primary:focus {
    background-color: #ff9550;
}

/* ---- Results ---- */

.results {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 12px;
}

.results__column {
    align-items: center;
    min-width: 150px;
    margin: 0 10px;
}

.results__label {
    font-size: 22px;
    color: var(--muted);
    -unity-text-align: middle-center;
}

.results__caption {
    font-size: 20px;
    color: var(--ink);
    -unity-text-align: middle-center;
    margin-top: 4px;
}

.results__caption--next {
    color: var(--muted);
    margin-bottom: 4px;
}

.results__value--small {
    font-size: 40px;
}

.results__value {
    font-size: 54px;
    color: #ffffff;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: var(--ink);
    -unity-text-align: middle-center;
}

.badge {
    margin-left: 8px;
    padding: 2px 8px;
    border-radius: 8px;
    background-color: #e8432f;
    color: #ffffff;
    font-size: 18px;
}

/* ---- Medals: a coloured disc with a ribbon notch ---- */

.medal {
    width: 96px;
    height: 96px;
    margin: 6px 0;
    border-radius: 48px;
    border-width: 6px;
    border-color: rgba(59, 36, 20, 0.25);
    background-color: rgba(59, 36, 20, 0.12);
}

.medal__shine {
    position: absolute;
    left: 14px;
    top: 14px;
    right: 14px;
    bottom: 14px;
    border-radius: 40px;
    border-width: 4px;
    border-color: rgba(255, 255, 255, 0.45);
}

.medal--small {
    width: 34px;
    height: 34px;
    margin: 0;
    border-width: 3px;
    border-radius: 17px;
}

.medal--bronze {
    background-color: #d0844a;
    border-color: #8c4f22;
}

.medal--silver {
    background-color: #d7dee6;
    border-color: #8796a6;
}

.medal--gold {
    background-color: #ffcc33;
    border-color: #c08a00;
}

.medal--platinum {
    background-color: #bff3ff;
    border-color: #4fb3c9;
}

/* ---- Fire button (bottom right) ---- */

.fire-button {
    position: absolute;
    right: 28px;
    bottom: 28px;
    width: 112px;
    height: 112px;
    border-radius: 56px;
    border-width: 5px;
    border-color: var(--ink);
    background-color: rgba(59, 36, 20, 0.55);
    padding: 0;
    margin: 0;
    overflow: hidden;
    justify-content: center;
}

.fire-button__charge {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 100%;
    background-color: var(--accent);
}

.fire-button--ready .fire-button__charge {
    background-color: #ffb43a;
}

.fire-button__label {
    color: #ffffff;
    font-size: 24px;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: var(--ink);
    -unity-text-align: middle-center;
}

/* ---- Crash flash ---- */

.flash {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: #ffffff;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.35s;
}

.flash--on {
    opacity: 0.75;
    transition-duration: 0s;
}
